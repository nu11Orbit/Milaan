# ─────────────────────────────────────────────────────────────────────────────
# ReconAI — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — .env is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: cloud.mongodb.com → Connect → Drivers → copy connection string
# Replace <username>, <password>, and <cluster-host>.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=reconai-cluster
MONGODB_DB_NAME=reconai

# ── LLM providers ─────────────────────────────────────────────────────────────
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Groq (fallback): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Optional model overrides ──────────────────────────────────────────────────
# Primary Gemini model — gemini-3.6-flash is a thinking model, confirmed working.
GEMINI_MODEL=gemini-3.6-flash
# Primary Groq model (compound-mini internally routes to llama-3.3-70b-versatile)
GROQ_MODEL=groq/compound-mini
# Fallback Groq model — used automatically when compound-mini hits its 100k TPD limit.
# qwen/qwen3.6-27b has a separate daily token quota.
GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b
# Read timeout — gemini-3.6-flash is a thinking model; 30s gives headroom.
LLM_TIMEOUT_SECONDS=30
# Circuit breaker threshold — skip provider after N consecutive failures.
LLM_CIRCUIT_BREAKER_THRESHOLD=3

# ── Confidence band thresholds (0–100) ───────────────────────────────────────
# auto_accept: score >= this → auto-matched, no human review needed
# THRESHOLD_AUTO_ACCEPT=85.0
# review: score >= this → review queue; below → exception/reject
# THRESHOLD_REVIEW=50.0

# ── Matching engine tuning ────────────────────────────────────────────────────
# AMOUNT_TOLERANCE_RUPEES=2.0        # ±₹ rounding drift tolerance
# CANDIDATE_DATE_WINDOW_DAYS=60      # max date gap for candidate narrowing
# FUZZY_SCORE_THRESHOLD=60.0         # minimum Pass 2 composite score
# EMBEDDING_SIMILARITY_FLOOR=0.5     # minimum Pass 3 cosine similarity
# SPLIT_POOL_MAX_SIZE=8              # max txn pool for subset-sum search

# ── CORS (comma-separated origins for production) ─────────────────────────────
# CORS_ORIGINS=["https://your-app.vercel.app"]
