# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets — NEVER commit these ────────────────────────────────
.env
.env.local
.env.*.local

# ── Sentence-transformers model cache (downloaded at runtime, not committed) ───
# The model cache lives in ~/.cache/huggingface/ by default.
# If you set HF_HOME or SENTENCE_TRANSFORMERS_HOME to a local dir, add it below.
.cache/
backend/sentence_model_cache/

# ── Node / Next.js ────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env
frontend/.env.local

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Testing / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
